{
  "name": "flow-layout-dagre",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/tailng-ui/flow-layout-dagre/src",
  "projectType": "library",
  "release": {
    "version": {
      "manifestRootsToUpdate": ["dist/{projectRoot}"],
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  },
  "tags": ["scope:tailng", "type:flow"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "cache": true,
      "dependsOn": ["^build"],
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/tailng-ui/flow-layout-dagre",
        "main": "libs/tailng-ui/flow-layout-dagre/src/index.ts",
        "tsConfig": "libs/tailng-ui/flow-layout-dagre/tsconfig.lib.json",
        "assets": [
          "libs/tailng-ui/flow-layout-dagre/README.md",
          "libs/tailng-ui/flow-layout-dagre/package.json"
        ]
      }
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "vite:test": {
      "executor": "@nx/vitest:test",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "configFile": "libs/tailng-ui/flow-layout-dagre/vitest.config.ts",
        "reportsDirectory": "coverage/libs/tailng-ui/flow-layout-dagre",
        "watch": false
      }
    }
  }
}
