{
  "extends": "./tsconfig.lib.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "../../../dist/libs/tailng-ui/flow/src",
    "paths": {
      "@tailng-ui/flow": ["libs/tailng-ui/flow/src/index.ts"],
      "@tailng-ui/flow/*": ["libs/tailng-ui/flow/src/*"],
      "@tailng-ui/components": ["dist/libs/tailng-ui/components/src/index.d.ts"],
      "@tailng-ui/components/*": ["dist/libs/tailng-ui/components/src/*"],
      "@tailng-ui/icons": ["dist/libs/tailng-ui/icons/src/index.d.ts"],
      "@tailng-ui/icons/*": ["dist/libs/tailng-ui/icons/src/*"]
    }
  },
  "angularCompilerOptions": {
    "compilationMode": "partial"
  }
}
